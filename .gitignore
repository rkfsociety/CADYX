# Local Revopoint map and export samples; do not publish device capture data.
/framesmall.mkf
/framesmall_points.csv
/framesmall_points.ply
*.tmp
.runtime/
tools/revopoint/build/
# Keep device calibration inside its scanner/table profile. Only the MINI's
# Q matrix and scale are tracked; marker maps and auxiliary calibration remain local.
tools/revopoint/calibration/*
!tools/revopoint/calibration/README.md
!tools/revopoint/calibration/scanners/
tools/revopoint/calibration/scanners/*
!tools/revopoint/calibration/scanners/revopoint-mini-y16/
tools/revopoint/calibration/scanners/revopoint-mini-y16/*
!tools/revopoint/calibration/scanners/revopoint-mini-y16/Q.bin
!tools/revopoint/calibration/scanners/revopoint-mini-y16/depth_scale.json

# Local credentials and runtime configuration (never commit real tokens).
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx
*.token
*.secret

